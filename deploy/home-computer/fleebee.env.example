#
# Fleebee home-computer deployment config
# This file should live at:
#   /home/richard/fleebee/shared/.env
#

#
# Single web app runtime
#
PORT=4100
PUBLIC_APP_URL=https://fleebee.esonga.online

#
# Dashboard runtime config
# Leave DASHBOARD_API_BASE_URL blank for same-origin requests.
#
DASHBOARD_PUBLIC_DIR=
DASHBOARD_API_BASE_URL=
APP_NAME=Fleebee Dispatch Desk
BOARD_REFRESH_INTERVAL_MS=5000
MESSAGE_RESULT_TIMEOUT_MS=18000
MESSAGE_RESULT_POLL_MS=1500

#
# Backend storage and API behavior
#
DATABASE_URL=file:/home/richard/fleebee/shared/fleebee.db
CORS_ALLOW_ORIGIN=https://fleebee.esonga.online
JOB_STALE_MS=60000
PHONE_HEARTBEAT_STALE_MS=20000
DUPLICATE_WINDOW_MS=600000
# Private bearer token shared only with the loopback fine-monitor worker.
FINE_MONITOR_SERVICE_TOKEN=
# Worker process used by manual Refresh and the daily/weekly scheduler.
FINE_MONITOR_NODE_BINARY=/home/richard/fleebee/runtime/node/bin/node
FINE_MONITOR_SCRIPT_PATH=/home/richard/fleebee/current/fine-monitor/src/run-once.js
FINE_MONITOR_ENV_FILE=/home/richard/fleebee/shared/fine-monitor.env
FINE_MONITOR_SCHEDULER_POLL_MS=60000
# Private bearer token shared only with the loopback Google Sheets data-sync worker.
DATA_SYNC_SERVICE_TOKEN=
DATA_SYNC_NODE_BINARY=/home/richard/fleebee/runtime/node/bin/node
DATA_SYNC_SCRIPT_PATH=/home/richard/fleebee/current/data-sync/src/run-once.js
DATA_SYNC_ENV_FILE=/home/richard/fleebee/shared/data-sync.env
DATA_SYNC_SCHEDULER_POLL_MS=60000

# Private Bank Statement service; never expose the API key to browser code.
BANK_STATEMENT_SERVICE_URL=http://127.0.0.1:8100
BANK_STATEMENT_SERVICE_API_KEY=
BANK_STATEMENT_SERVICE_TIMEOUT_MS=30000
BANK_STATEMENT_MAX_UPLOAD_BYTES=10485760

#
# SMS dispatch protection
#
# Initial default saved into the database when the app boots with no stored SMS send password yet.
SMS_SEND_PASSWORD=1234
# Admin-only password for changing SMS send settings from the SMS page.
SMS_ADMIN_PASSWORD=1234
# Browser login password for the dashboard UI.
APP_LOGIN_PASSWORD=1234
# Cookie-signing secret for the browser session.
APP_SESSION_SECRET=change-this-before-public-https
# Idle timeout before the browser session expires.
APP_SESSION_IDLE_TIMEOUT_MS=900000
# Cookie settings for the browser session.
APP_SESSION_COOKIE_NAME=fleebee_session
APP_SESSION_COOKIE_SECURE=false

#
# Gateway identity and phone defaults
#
PHONE_STATE_ID=android-home-gateway
SMS_GATEWAY_MODE=registered-bikers
# Only used when SMS_GATEWAY_MODE=test-routing.
SMS_GATEWAY_TARGET_NUMBER=0788690545
SMS_GATEWAY_FIXED_LOCATION=Home gateway
SMS_GATEWAY_BATTERY_POLICY=Needs manual unrestricted setting on Samsung
SMS_GATEWAY_NETWORK_LABEL=Wi-Fi / mobile fallback
SMS_GATEWAY_DEVICE_ID=android-home-gateway
SMS_GATEWAY_ADB_COMMAND=/home/richard/bin/adb-home
# Optional: set the real USB serial if more than one Android device may appear in ADB.
SMS_GATEWAY_ADB_SERIAL=
SMS_GATEWAY_ADB_TIMEOUT_MS=4000
SEED_DEFAULT_BIKERS=false

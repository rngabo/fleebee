generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Biker {
  id                   String             @id
  name                 String
  firstName            String             @default("")
  phoneNumber          String
  bikePlate            String             @default("")
  bikeModel            String             @default("")
  status               String
  reminderDue          Boolean            @default(false)
  urgentAlert          Boolean            @default(false)
  notificationsEnabled Boolean            @default(true)
  isTeamLeader         Boolean            @default(false)
  notes                String             @default("")
  batchId              String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  batch                Batch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  bikes                Bike[]
  dataMembers          DataMember[]
  fines                Fine[]
  messages             Message[]
  schedules            ScheduledMessage[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([batchId, createdAt])
}

model Message {
  id                     String            @id
  bikerId                String
  bikerName              String
  bikeId                 String?
  templateId             String?
  source                 MessageSource     @default(manual)
  scheduledMessageId     String?
  sendGroupId            String?
  sendGroupKind          String?
  sendGroupLabel         String?
  category               MessageCategory
  body                   String
  deliveryBody           String            @default("")
  normalizedBody         String
  workflowStage          String?
  workflowCategory       String?
  workflowUrgency        String?
  status                 MessageStatus     @default(pending)
  availableAt            DateTime?
  createdAt              DateTime          @default(now())
  claimedAt              DateTime?
  claimedBy              String?
  resultAt               DateTime?
  resultNote             String?
  failureReason          String?
  route                  String
  targetNumber           String
  targetNumberNormalized String
  bike                   Bike?             @relation(fields: [bikeId], references: [id], onDelete: SetNull)
  biker                  Biker             @relation(fields: [bikerId], references: [id], onDelete: Restrict)
  scheduledMessage       ScheduledMessage? @relation(fields: [scheduledMessageId], references: [id], onDelete: SetNull)
  template               SmsTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, availableAt, createdAt])
  @@index([targetNumberNormalized, normalizedBody, createdAt])
  @@index([scheduledMessageId, createdAt])
  @@index([sendGroupId, createdAt])
  @@index([bikeId, createdAt])
  @@index([templateId, createdAt])
}

model AppSetting {
  id        String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PhoneState {
  id                String    @id
  mode              String
  targetNumber      String
  fixedLocation     String
  batteryPolicy     String
  network           String
  deviceId          String
  bundleUssdCode    String    @default("*131#")
  bundleStatus      String    @default("unknown")
  bundleSummary     String?
  bundleDetails     String?
  bundleLastError   String?
  bundleCheckedAt   DateTime?
  bundleRequestedAt DateTime?
  lastHeartbeatAt   DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ScheduledMessage {
  id                  String                 @id
  bikerId             String
  bikerName           String
  category            MessageCategory
  body                String
  normalizedBody      String
  recurrence          ScheduleRecurrence
  status              ScheduledMessageStatus @default(active)
  sendAt              DateTime
  nextRunAt           DateTime?
  timeOfDay           String
  dayOfWeek           Int?
  dayOfMonth          Int?
  lastRunAt           DateTime?
  lastQueuedMessageId String?
  lastDispatchStatus  String?
  lastDispatchNote    String?
  completedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  biker               Biker                  @relation(fields: [bikerId], references: [id], onDelete: Restrict)
  messages            Message[]

  @@index([status, nextRunAt])
  @@index([createdAt])
}

model Batch {
  id                   String    @id
  name                 String    @unique
  code                 String    @default("")
  notes                String    @default("")
  expectedDeliveryDate DateTime?
  leaseEndDate         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  bikers               Biker[]
  bikes                Bike[]

  @@index([createdAt])
}

model Bike {
  id                   String               @id
  bikerId              String
  batchId              String?
  plateNumber          String?
  chassisNumber        String?
  bikeModel            String?
  lifecycleStage       String               @default("LEAD_CAPTURED")
  insuranceStatus      String               @default("")
  authorizationStatus  String               @default("")
  pickupStatus         String               @default("")
  officialStartDate    DateTime?
  nextPaymentDate      DateTime?
  notificationsEnabled Boolean              @default(true)
  knownModelIssues     String               @default("")
  maintenanceNotes     String               @default("")
  notes                String               @default("")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  batch                Batch?               @relation(fields: [batchId], references: [id], onDelete: SetNull)
  biker                Biker                @relation(fields: [bikerId], references: [id], onDelete: Restrict)
  dataMembers          DataMember[]
  fines                Fine[]
  messages             Message[]
  progressUpdates      BikeProgressUpdate[]

  @@index([createdAt])
  @@index([bikerId, createdAt])
  @@index([batchId, createdAt])
  @@index([lifecycleStage, createdAt])
}

model BikeProgressUpdate {
  id                  String       @id
  bikeId              String
  stage               String
  category            String
  urgency             String
  note                String       @default("")
  notifyRecipient     Boolean      @default(true)
  templateId          String?
  sentMessageId       String?
  renderedMessageBody String       @default("")
  createdBy           String       @default("operator")
  createdAt           DateTime     @default(now())
  bike                Bike         @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  template            SmsTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([bikeId, createdAt])
  @@index([stage, createdAt])
}

model Fine {
  id                   String       @id
  bikeId               String
  bikerId              String
  amount               String
  amountRwf            Int?
  currency             String       @default("RWF")
  reason               String
  fineDate             DateTime
  paymentDeadline      DateTime?
  source               String       @default("manual")
  externalTicketNumber String?
  sourceSummary        String       @default("")
  firstSeenAt          DateTime     @default(now())
  lastSeenAt           DateTime     @default(now())
  lastCheckedAt        DateTime     @default(now())
  isCurrentlyReported  Boolean      @default(true)
  resolvedAt           DateTime?
  notifyRecipient      Boolean      @default(true)
  templateId           String?
  sentMessageId        String?
  renderedMessageBody  String       @default("")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  bike                 Bike         @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  biker                Biker        @relation(fields: [bikerId], references: [id], onDelete: Restrict)
  template             SmsTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([source, externalTicketNumber])
  @@index([bikeId, createdAt])
  @@index([bikerId, createdAt])
  @@index([source, isCurrentlyReported, lastSeenAt])
}

model FineCheckRun {
  id           String                  @id
  trigger      String                  @default("manual-canary")
  status       String                  @default("RUNNING")
  targetCount  Int                     @default(0)
  foundCount   Int                     @default(0)
  clearCount   Int                     @default(0)
  failedCount  Int                     @default(0)
  skippedCount Int                     @default(0)
  startedAt    DateTime                @default(now())
  completedAt  DateTime?
  errorMessage String                  @default("")
  targets      FineCheckTargetResult[]

  @@index([startedAt])
  @@index([status, startedAt])
}

model FineCheckTargetResult {
  id           String       @id
  runId        String
  bikeId       String
  bikerId      String
  bikerName    String
  plateNumber  String
  state        String       @default("PENDING")
  fineCount    Int          @default(0)
  errorCode    String       @default("")
  errorMessage String       @default("")
  retryCount   Int          @default(0)
  checkedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  run          FineCheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, bikeId])
  @@index([bikeId, checkedAt])
  @@index([state, checkedAt])
}

model DataSyncRun {
  id                String                 @id
  trigger           String                 @default("manual")
  status            String                 @default("RUNNING")
  spreadsheetId     String
  memberCount       Int                    @default(0)
  paymentCount      Int                    @default(0)
  dashboardRowCount Int                    @default(0)
  linkedMemberCount Int                    @default(0)
  createdBikerCount Int                    @default(0)
  createdBikeCount  Int                    @default(0)
  conflictCount     Int                    @default(0)
  startedAt         DateTime               @default(now())
  completedAt       DateTime?
  errorMessage      String                 @default("")
  dashboardSnapshot DataDashboardSnapshot?

  @@index([startedAt])
  @@index([status, startedAt])
}

model DataMember {
  id                String             @id
  sourcePersonId    String             @unique
  bikerId           String?
  bikeId            String?
  sourceStatus      String             @default("")
  sourceName        String
  normalizedName    String
  startDate         DateTime?
  batchCode         String             @default("")
  monthlyDueRwf     Int?
  weeklyDueRwf      Int?
  durationMonths    Int?
  dueDayOne         String             @default("")
  dueDayTwo         String             @default("")
  firstMonthDueRwf  Int?
  lastMonthDueRwf   Int?
  notes             String             @default("")
  sourcePhone       String             @default("")
  sourcePlate       String             @default("")
  chargingCode      String             @default("")
  extraChargesRwf   Int                @default(0)
  activeNumber      Int?
  comment           String             @default("")
  sourceRowNumber   Int
  sourceFingerprint String
  matchStatus       String             @default("UNMATCHED")
  matchNote         String             @default("")
  isPresent         Boolean            @default(true)
  lastSeenRunId     String             @default("")
  lastSeenAt        DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  biker             Biker?             @relation(fields: [bikerId], references: [id], onDelete: SetNull)
  bike              Bike?              @relation(fields: [bikeId], references: [id], onDelete: SetNull)
  payments          DataPayment[]
  dashboardRows     DataDashboardRow[]

  @@index([bikerId, isPresent])
  @@index([bikeId, isPresent])
  @@index([sourcePlate, isPresent])
  @@index([normalizedName, isPresent])
}

model DataPayment {
  id                String     @id
  sourceKey         String     @unique
  dataMemberId      String
  bikerId           String?
  paymentDate       DateTime
  amountRwf         Int
  paymentMethod     String     @default("")
  referenceNote     String     @default("")
  enteredBy         String     @default("")
  sourceRowNumber   Int
  sourceFingerprint String
  isPresent         Boolean    @default(true)
  lastSeenRunId     String     @default("")
  lastSeenAt        DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  dataMember        DataMember @relation(fields: [dataMemberId], references: [id], onDelete: Cascade)

  @@index([dataMemberId, paymentDate])
  @@index([bikerId, paymentDate])
  @@index([paymentDate, isPresent])
}

model DataDashboardSnapshot {
  id                     String             @id
  runId                  String             @unique
  selectedDate           DateTime?
  monthStart             DateTime?
  monthEnd               DateTime?
  totalMonthlyDueRwf     Int                @default(0)
  totalPaidInMonthRwf    Int                @default(0)
  totalBalanceRwf        Int                @default(0)
  totalPaidByDateRwf     Int                @default(0)
  totalDueByDateRwf      Int                @default(0)
  totalOverallBalanceRwf Int                @default(0)
  createdAt              DateTime           @default(now())
  run                    DataSyncRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  rows                   DataDashboardRow[]

  @@index([createdAt])
}

model DataDashboardRow {
  id                  String                @id
  snapshotId          String
  dataMemberId        String?
  bikerId             String?
  sourceName          String
  batchCode           String                @default("")
  monthlyDueRwf       Int                   @default(0)
  paidInMonthRwf      Int                   @default(0)
  balanceRemainingRwf Int                   @default(0)
  lastPaymentDate     DateTime?
  paidByDateRwf       Int                   @default(0)
  dueByDateRwf        Int                   @default(0)
  overallBalanceRwf   Int                   @default(0)
  trackStatus         String                @default("")
  note                String                @default("")
  adjustmentAmountRwf Int?
  adjustmentNote      String                @default("")
  sourceRowNumber     Int
  createdAt           DateTime              @default(now())
  snapshot            DataDashboardSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  dataMember          DataMember?           @relation(fields: [dataMemberId], references: [id], onDelete: SetNull)

  @@index([snapshotId, sourceRowNumber])
  @@index([dataMemberId, createdAt])
  @@index([bikerId, createdAt])
}

model SmsTemplate {
  id               String               @id
  stage            String
  category         String
  urgency          String
  title            String
  body             String
  isActive         Boolean              @default(true)
  includeSignature Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  fines            Fine[]
  messages         Message[]
  progressUpdates  BikeProgressUpdate[]

  @@unique([stage, category, urgency])
  @@index([stage, category, urgency])
}

enum MessageCategory {
  REMINDER
  GENERAL
  EMERGENCY
}

enum MessageStatus {
  pending
  queued
  dispatched
  submitted
  sent
  failed
}

enum MessageSource {
  manual
  scheduled
  workflow
}

enum ScheduleRecurrence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  EVERY_2_MONTHS
  EVERY_3_MONTHS
  EVERY_4_MONTHS
  EVERY_5_MONTHS
}

enum ScheduledMessageStatus {
  active
  paused
  completed
}
